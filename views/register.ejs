<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ثبت نام - Mobile Bank</title>

    <!-- فونت فارسی -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #eef2ff;
        --card: rgba(255, 255, 255, 0.75);
        --primary: #3b82f6;
        --purple: #8b5cf6;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Vazirmatn", sans-serif;
      }

      body {
        background:
          radial-gradient(circle at top left, #dbeafe, transparent 35%),
          radial-gradient(circle at top right, #ede9fe, transparent 35%),
          #f8fafc;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .container {
        width: 100%;
        max-width: 400px;
      }

      .card {
        background: var(--card);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 32px;
        box-shadow:
          0 25px 60px rgba(99, 102, 241, 0.12),
          0 10px 25px rgba(0, 0, 0, 0.05);
        padding: 30px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      /* عنوان */
      .card h2 {
        text-align: center;
        font-size: 24px;
        color: #111827;
      }

      /* اینپوت‌ها */
      .card input {
        height: 55px;
        padding: 0 18px;
        border-radius: 20px;
        border: none;
        background: #f8fafc;
        box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.05);
        font-size: 16px;
      }

      /* دکمه ثبت نام */
      .card button {
        height: 60px;
        border: none;
        border-radius: 22px;
        background: linear-gradient(90deg, var(--purple), var(--primary));
        color: white;
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 15px 35px rgba(99, 102, 241, 0.35);
        transition: 0.3s;
      }
      .card button:hover {
        transform: translateY(-2px);
      }

      /* لینک ورود */
      .login-link {
        text-align: center;
        font-size: 14px;
        margin-top: 10px;
      }
      .login-link a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h2>ساخت حساب کاربری</h2>

        <form action="/auth/register" method="post">
          <input type="text" name="name" placeholder="نام و نام خانوادگی" />
          <input type="text" name="username" placeholder="نام کاربری" />
          <input type="password" name="password" placeholder="رمز عبور" />

          <button type="submit">ثبت نام</button>
        </form>

        <div class="login-link">حساب دارید؟ <a href="/auth/login">ورود</a></div>
      </div>
    </div>

          <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

      <% if (messages.error && messages.error.length > 0) { %>
    <script>
      swal({
        title: "<%= messages.error[0] %>",
        icon: "error",
        button: "تلاش مجدد",
      });
    </script>
  <% } %>

  <% if (messages.success && messages.success.length > 0) { %>
    <script>
      swal({
        title: "<%= messages.success[0] %>",
        icon: "success",
        button: "باشه",
      });
    </script>
  <% } %>
  </body>
</html>
